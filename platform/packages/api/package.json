{
  "name": "@platform-service/api",
  "private": true,
  "type": "module",
  "exports": {
    "./tiers": "./src/tiers.ts",
    "./id": "./src/id.ts",
    "./reserved-slugs": "./src/reserved-slugs.ts",
    "./routing": "./src/routing.ts",
    "./usage-auth": "./src/usage-auth.ts",
    "./proxy-token": "./src/proxy-token.ts",
    "./github-repo-path": "./src/github/repo-path.ts",
    "./rpc": "./src/rpc/registry.ts"
  },
  "scripts": {
    "check:ai-logging": "node scripts/check-ai-logging.ts",
    "db:generate": "drizzle-kit generate",
    "deploy": "node ../../scripts/wrangler-deploy.ts",
    "deploy:github-webhook-ingress": "node ../../scripts/wrangler-deploy.ts --config wrangler.github-webhook-ingress.jsonc",
    "dev": "wrangler dev",
    "dev:admin": "wrangler dev --local --enable-containers=false --live-reload --host localhost --port 8787",
    "migrate": "drizzle-kit migrate",
    "migrate:staging": "DATABASE_URL=$STAGING_DATABASE_URL drizzle-kit migrate",
    "setup": "node scripts/setup-local.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/core": "catalog:",
    "@astryxdesign/theme-neutral": "catalog:",
    "@builtbyfriends/bwf": "workspace:*",
    "@builtbyfriends/deploy-core": "workspace:*",
    "@builtbyfriends/edge": "workspace:*",
    "@builtbyfriends/platform": "workspace:*",
    "@builtbyfriends/realtime": "^0.7.0",
    "@builtbyfriends/realtime-http": "^0.7.0",
    "@builtbyfriends/realtime-mcp": "^0.7.0",
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/sandbox": "catalog:",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nkzw/fate": "catalog:",
    "@sentry/cloudflare": "11.16.0",
    "@stylexjs/stylex": "catalog:",
    "@xterm/headless": "^6.0.0",
    "agents": "^0.34.0",
    "arktype": "catalog:",
    "aws4fetch": "^1.0.20",
    "blake3-jit": "^1.1.1",
    "cron-parser": "catalog:",
    "drizzle-orm": "^0.45.4",
    "hono": "catalog:platform",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "mime": "catalog:",
    "oauth4webapi": "catalog:",
    "pg": "8.23.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-fate": "catalog:",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:platform",
    "@electric-sql/pglite": "catalog:",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@voidzero-dev/vite-plus-prompts": "catalog:",
    "drizzle-kit": "^0.31.11",
    "miniflare": "catalog:",
