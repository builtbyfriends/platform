{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run --filter './packages/**' build",
    "build:core": "vp run --filter ./packages/deploy-core --filter ./packages/deploy-cloudflare --filter ./packages/edge --filter ./packages/platform --filter ./packages/bwf build",
    "build:docs": "vp run --filter ./docs build",
    "build:platform": "vp run --filter './platform/packages/**' build",
    "check": "vp run --filter './**' --filter '!./playground-local/**' --parallel --concurrency-limit=4 typecheck",
    "check:platform": "vp run --filter './platform/**' --parallel typecheck",
    "check:sdk": "vp run --filter './packages/**' --parallel typecheck",
    "comments": "node scripts/comments.ts",
    "deploy:docs": "vp run build:core && node packages/bwf/dist/cli/cli.mjs deploy",
    "dev:docs": "vp run --filter ./docs dev",
    "dev:platform": "vp run --filter @platform-service/platform dev",
    "fmt": "vp fmt --write .",
    "install:bwf-dev": "vp run build:core && node scripts/bwf-dev-link.mjs install",
    "lint": "vp lint",
    "prepare": "vp config && vp run build:core",
    "test": "node test/affected.mjs",
    "test:full": "vp test run",
    "test:integration": "vp test run --project parallel-integration",
    "test:platform": "vp test run --project 'platform-*'",
    "test:profile": "vp test run --reporter=default --experimental.importDurations.print --experimental.importDurations.limit=20",
    "test:unit": "vp test run --project unit --project unit-pglite --project cli-unit",
    "uninstall:bwf-dev": "node scripts/bwf-dev-link.mjs uninstall",
    "upstream:sync": "node scripts/upstream-sync.ts"
  },
  "devDependencies": {
    "@aranlucas/oxlint-plugin-anti-slop": "catalog:",
    "@cloudflare/oxlint-config": "catalog:",
    "@types/cross-spawn": "^6.0.6",
    "cross-spawn": "^7.0.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "catalog:",
    "playwright": "catalog:",
    "rolldown": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
