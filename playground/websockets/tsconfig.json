{
  "extends": "./.bwf/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["@builtbyfriends/bwf/env"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "routes"]
}
