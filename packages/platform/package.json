{
  "name": "@builtbyfriends/platform",
  "version": "1.13.3",
  "description": "Packaged runtime and installation contracts for self-hosted bwf platforms.",
  "homepage": "https://github.com/builtbyfriends/platform",
  "bugs": {
    "url": "https://github.com/builtbyfriends/platform/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtbyfriends/platform.git",
    "directory": "packages/platform"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./installer": {
      "types": "./dist/installer.d.mts",
      "import": "./dist/installer.mjs"
    },
    "./email-protocol": {
      "types": "./dist/email-protocol.d.mts",
      "import": "./dist/email-protocol.mjs"
    },
    "./plans": {
      "types": "./dist/plans.d.mts",
      "import": "./dist/plans.mjs"
    },
    "./ai-logging": {
      "types": "./dist/ai-logging.d.mts",
      "import": "./dist/ai-logging.mjs"
    },
    "./browser-page": {
      "types": "./dist/browser-page.d.mts",
      "import": "./dist/browser-page.mjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vp pack && node scripts/build-runtime.mjs && vp run build:stamp",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@builtbyfriends/deploy-core": "workspace:*",
    "pathslash": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
